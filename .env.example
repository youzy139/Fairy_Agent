# Fairy Agent 配置模板
# 复制为 .env 后填写真实值；.env 不得提交 Git。

# OpenAI 兼容 API Key（无默认值，必填；本地模型端点可填任意占位值，如 ollama）
OPENAI_API_KEY=

# OpenAI 兼容端点（默认值：https://api.openai.com/v1）
# 本地模型示例：http://localhost:11434/v1（Ollama）
OPENAI_BASE_URL=https://api.openai.com/v1

# 主模型（默认值：gpt-4o-mini）
FAIRY_MODEL=gpt-4o-mini

# 采样温度（默认值：0.7）
FAIRY_TEMPERATURE=0.7

# 数据目录，审计日志写入其下 audit.jsonl（默认值：~/.fairy）
FAIRY_DATA_DIR=~/.fairy

# 日志级别（默认值：INFO）
FAIRY_LOG_LEVEL=INFO

# 是否允许 Shell 工具（默认值：false；危险级工具，默认关闭）
FAIRY_ALLOW_SHELL=false

# 危险操作是否需要二次确认（默认值：true；强烈建议保持开启）
FAIRY_CONFIRM_DANGEROUS=true

# 是否启用沙箱（默认值：false；v0.3 规划）
FAIRY_SANDBOX=false

# 记忆后端（默认值：sqlite）
FAIRY_MEMORY_BACKEND=sqlite

# 向量模型（无默认值；规划中）
FAIRY_EMBEDDING_MODEL=

# 应用白名单：open_app 对名单内的应用免确认直接启动（逗号分隔，大小写不敏感）
# 示例：FAIRY_APP_WHITELIST=计算器,记事本,微信
FAIRY_APP_WHITELIST=

# 项目根目录：open_project 在这些目录的第一层子目录中匹配项目名（逗号分隔）
# 默认值：~/Desktop/project,~/projects,~/code
FAIRY_PROJECT_ROOTS=~/Desktop/project,~/projects,~/code

# 全局热键：召唤悬浮指令条（默认值：ctrl+shift+space；格式如 ctrl+alt+k、f5）
FAIRY_HOTKEY=ctrl+shift+space

# 路径白名单：读类工具（list_dir/read_file/search_files）额外允许访问的目录（逗号分隔）
# 写入工具不受白名单影响，永远限制在工作区内
# 示例：FAIRY_PATH_WHITELIST=~/Documents,~/Desktop
FAIRY_PATH_WHITELIST=

# 命令白名单：run_command 中命中前缀的命令降级为单次确认（逗号分隔，黑名单优先）
# 示例：FAIRY_COMMAND_WHITELIST=git status,git diff,pwd,ls
FAIRY_COMMAND_WHITELIST=

# 语音总开关：按键说话（STT，本地识别）（默认值：false；需 pip install fairy-agent[voice]）
FAIRY_VOICE=false

# 语音识别模型规格（默认值：small；可选 tiny/base/small/medium，越大越准越慢）
FAIRY_STT_MODEL=small

# 语音回复（TTS，edge-tts 在线合成）（默认值：true，随 FAIRY_VOICE 生效）
FAIRY_TTS=true

# TTS 声音（默认值：zh-CN-XiaoxiaoNeural；更多声音见 edge-tts --list-voices）
FAIRY_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 语音热键（默认值：ctrl+shift+v；按一下开始录音，再按一次结束并识别）
FAIRY_VOICE_HOTKEY=ctrl+shift+v
