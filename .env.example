# Fairy Agent 配置模板
# 复制为 .env 后填写真实值；.env 不得提交 Git。

# OpenAI 兼容 API Key（无默认值，必填；本地模型端点可填任意占位值，如 ollama）
OPENAI_API_KEY=

# OpenAI 兼容端点（默认值：https://api.openai.com/v1）
# 本地模型示例：http://localhost:11434/v1（Ollama）
OPENAI_BASE_URL=https://api.openai.com/v1

# 主模型（默认值：gpt-4o-mini）
FAIRY_MODEL=gpt-4o-mini

# 采样温度（默认值：0.7）
FAIRY_TEMPERATURE=0.7

# 数据目录，审计日志写入其下 audit.jsonl（默认值：~/.fairy）
FAIRY_DATA_DIR=~/.fairy

# 日志级别（默认值：INFO）
FAIRY_LOG_LEVEL=INFO

# 是否允许 Shell 工具（默认值：false；危险级工具，默认关闭）
FAIRY_ALLOW_SHELL=false

# 危险操作是否需要二次确认（默认值：true；强烈建议保持开启）
FAIRY_CONFIRM_DANGEROUS=true

# 是否启用沙箱（默认值：false；v0.3 规划）
FAIRY_SANDBOX=false

# 记忆后端（默认值：sqlite）
FAIRY_MEMORY_BACKEND=sqlite

# 向量模型（无默认值；规划中）
FAIRY_EMBEDDING_MODEL=

# 应用白名单：open_app 对名单内的应用免确认直接启动（逗号分隔，大小写不敏感）
# 示例：FAIRY_APP_WHITELIST=计算器,记事本,微信
FAIRY_APP_WHITELIST=

# 项目根目录：open_project 在这些目录的第一层子目录中匹配项目名（逗号分隔）
# 默认值：~/Desktop/project,~/projects,~/code
FAIRY_PROJECT_ROOTS=~/Desktop/project,~/projects,~/code
